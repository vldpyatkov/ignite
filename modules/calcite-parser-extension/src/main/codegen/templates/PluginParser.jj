<#assign effectiveParser = parser + (plugin.parser.override!{})>

<#list (plugin.parser.replace!{}) as propertyName, replacements>
  <#if effectiveParser[propertyName]??>
    <#assign baseValues = effectiveParser[propertyName]>
  <#elseif default.parser[propertyName]??>
    <#assign baseValues = default.parser[propertyName]>
  <#else>
    <#stop "Cannot replace values of unknown parser property '" + propertyName + "'">
  </#if>

  <#assign replacedValues = []>
  <#assign replacedNames = []>

  <#list baseValues as value>
    <#if replacements[value]??>
      <#assign replacedValues = replacedValues + [replacements[value]]>
      <#assign replacedNames = replacedNames + [value]>
    <#else>
      <#assign replacedValues = replacedValues + [value]>
    </#if>
  </#list>

  <#list replacements as oldValue, newValue>
    <#if !replacedNames?seq_contains(oldValue)>
      <#stop "Cannot replace missing value '" + oldValue + "' in parser property '" + propertyName + "'">
    </#if>
  </#list>

  <#assign effectiveParser = effectiveParser + {propertyName: replacedValues}>
</#list>

<#list (plugin.parser.append!{}) as propertyName, additions>
  <#if effectiveParser[propertyName]??>
    <#assign baseValues = effectiveParser[propertyName]>
  <#elseif default.parser[propertyName]??>
    <#assign baseValues = default.parser[propertyName]>
  <#else>
    <#assign baseValues = []>
  </#if>

  <#assign effectiveParser = effectiveParser + {propertyName: baseValues + additions}>
</#list>

<#assign parser = effectiveParser>

<#include "Parser.jj">
